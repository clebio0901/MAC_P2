import funcoes
import os

while True:
    try:    
        print('Bem vindo! Vamos para a nossa anmnese\nMenu:\n')
        print('[1] Sintomas')
        print('[2] Sintomas Físicos')
        print('[0] Sair')

        op = int(input('\nQual opção desejada: '))
        if op == 1:
            funcoes.doencas()
            print("\n")
              
        elif op == 2:
            funcoes.fraturaOssea()

        elif op == 0:
            print('\n\033[1;32m------Volte Sempre!------\033[m')
            break

        else:
            print('Opção inválida.')


    except ValueError:
        os.system('cls')
        print('-------- Digite um valor correto ---------') 
        continue
