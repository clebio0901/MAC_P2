def repousar():
    print('O paciente deve \033[1;32mrepousar\033[m e \033[1;32mtomar medicação!\033[m')

def perguntar_sintoma(pergunta, sintoma, sintomas):
    resposta = input(pergunta)
    if resposta == 's' or resposta == 'S':
        sintomas.append(sintoma)


def doensas(): 
    while True:
        perguntar_sintoma('O paciente teve febre [s/n]:' , 'Febre' , sintomas)    
        perguntar_sintoma('O paciente teve Dor de cabeça [s/n]: ', 'Dor de cabeça', sintomas)
        perguntar_sintoma('O paciente teve tosse [s/n]: ', 'Tosse', sintomas)
        perguntar_sintoma('O paciente teve falta de Ar [s/n]: ', 'FaltaDeAr', sintomas)
        perguntar_sintoma('O paciente teve manchas vermelhas na pele [s/n]: ', 'ManchasVermelhas', sintomas)

                
        if 'Febre' in sintomas and 'Dor de cabeça' in sintomas and 'Tosse' in sintomas and 'FaltaDeAr' in sintomas:
            diagnostico_atual = 'Covid'
            print('\nO paciente tem: \033[1;31mCovid\033[m')
            altaOubaixa = input('\nO paciente sente \033[1;31mmuita\033[m ou \033[1;33mpouca\033[m falta de ar? ')
            if 'muita' in altaOubaixa:
                print('O paciente deve ser \033[1;31minternado!\033[m ')
            elif 'pouca' in altaOubaixa:
                repousar()
            else:
                print('Opção invalida')

        elif 'Febre' in sintomas and 'Dor de cabeça' in sintomas and 'Tosse' in sintomas:
            diagnostico_atual = 'Gripe'
            print('\nO paciente tem: \033[1;31mGripe\033[m')
            altaOubaixa = input('\nO paciente sente \033[1;31mmuita\033[m ou \033[1;33mpouca\033[m febre? ')
            if 'muita' in altaOubaixa:
                print('\n\033[1;31mUrgente:\033[m febre acima de \033[1;33m40°C\033[m o paciente deve ser \033[1;31minternado!\033[m ')
            elif 'pouca' in altaOubaixa:
                repousar()
            else:
                print('Opção invalida')


        elif 'Febre' in sintomas and 'Dor de cabeça' in sintomas and 'ManchasVermelhas' in sintomas:
            diagnostico_atual = 'Dengue'
            print('\nO paciente tem: \033[1;31mDengue\033[m')
            idade = input('O paciente tem mais de 70 anos? [s/n] ')
            if 's' in idade:
                print('\nO paciente precisar ser \033[1;31minternado!\033[m imediatamente! ')
            elif 'n' in idade:
                repousar()
            else:
                print('Opção invalida')

        else:
            print('Sem diagnóstico conclusivo')

        op = int(input('Deseja continuar [1] sim [2] não: '))
        if op == 1:
            for i in range(len(sintomas)): 
                diagnosticos.append(f'{i} paciente {sintomas}')
                print(f'Diagnóstico: {diagnostico_atual}')
            continue
        elif op == 2:
            print('\033[1;32mARVORE GERADA\033[m\n')
            def arvore(sintomas, nivel = 0):
                if not sintomas:
                    return
                print(' ' * nivel + '\033[1;36m|_\033[m' + str(sintomas[0]))
                arvore(sintomas[1:], nivel + 1)
                
            arvore(sintomas, nivel= 0 )
            print(f'\nDiagnóstico: {diagnostico_atual}')
            break
        else:
            print('Opção invalida')

          

