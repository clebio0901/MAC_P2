    print('O paciente deve \033[1;32mrepousar\033[m e \033[1;32mtomar medicação!\033[m')

def perguntar_sintoma(pergunta, sintoma):
    resposta = input(pergunta)
    if resposta == 's':
        sintomas.append(sintoma)

while True:
    sintomas = []
    doenca = input('Você está sentindo alguma coisa [s/n]: ') 
    if doenca == 's':    
        febre = input('O paciente teve febre [s/n]: ')
